# Database
DATABASE_URL=postgresql://grabit:grapit_dev@localhost:5432/grabit
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# Auth
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here

# OAuth - Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=http://localhost:8080/api/v1/auth/social/kakao/callback

# OAuth - Naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_CALLBACK_URL=http://localhost:8080/api/v1/auth/social/naver/callback

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/social/google/callback

# Toss Payments (public doc test keys -- safe to use as-is for development)
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
NEXT_PUBLIC_TOSS_PAYMENT_WIDGET_VARIANT_KEY=DEFAULT,paypal
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6
# Overseas card uses Toss API individual integration keys, separate from the widget key.
NEXT_PUBLIC_TOSS_OVERSEAS_CARD_CLIENT_KEY=
TOSS_OVERSEAS_CARD_SECRET_KEY=
# Overseas easy pay direct payment window uses a Toss API individual integration client key.
NEXT_PUBLIC_TOSS_FOREIGN_EASY_PAY_CLIENT_KEY=
TOSS_FOREIGN_EASY_PAY_SECRET_KEY=
# Shared secret required by POST /api/v1/payments/toss/webhook.
# Configure the Toss webhook endpoint with ?tossWebhookSecret=<same value>
# or send it via Authorization: Bearer / x-toss-webhook-secret in controlled tests.
TOSS_WEBHOOK_SECRET=change-me

# -- Toss Payments (E2E test-only -- CI-only keys, NEVER in deploy.yml) --
# Public docs test keys from Toss documentation (https://docs.tosspayments.com);
# safe to commit -- no real funds move. Used exclusively by Playwright E2E to prove
# we can reach Toss sandbox from CI without mixing test keys into production env.
# Key isolation rationale: 09-CONTEXT.md D-13.
TOSS_CLIENT_KEY_TEST=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
TOSS_SECRET_KEY_TEST=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6

# PayPal/Alipay checkout through Toss. Disabled by default; rate is a backend-owned USD quote input.
PAYPAL_CHECKOUT_ENABLED=false
ALIPAY_CHECKOUT_ENABLED=false
PAYPAL_KRW_USD_RATE=

# -- Translation / DeepL --
DEEPL_AUTH_KEY=

# -- Playwright E2E test user (Blocker B2) --
# Local: falls back to seed credentials (admin@grabit.test / TestAdmin2026! from
# apps/api/src/database/seed.mjs:39-50). Set these only if your seed differs.
# CI: set as GitHub secrets (TEST_USER_EMAIL / TEST_USER_PASSWORD) when the CI DB
# seeds different credentials.
# TEST_USER_EMAIL=admin@grabit.test
# TEST_USER_PASSWORD=TestAdmin2026!

# ---- SMS (Twilio Verify) ----
# production에서 ACCOUNT_SID + VERIFY_SERVICE_SID + 인증수단(API key pair 또는 Auth Token)이 필수.
# 하나라도 비면 SmsService 생성자 throw(hard-fail).
# NODE_ENV !== 'production' + 필수 값 미설정 시 dev mock 모드(000000 유니버설 코드).
# Twilio CLI setup:
#   twilio login
#   twilio api:verify:v2:services:create --friendly-name "Grabit Phone Verification" --code-length 6 --lookup-enabled --skip-sms-to-landlines --do-not-share-warning-enabled
# 생성된 VA... 값을 TWILIO_VERIFY_SERVICE_SID에 저장한다.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=

# Optional fallback: Console Auth Token을 쓰는 경우 API key pair 대신 설정한다.
TWILIO_AUTH_TOKEN=

# Optional: Twilio Verify SMS locale override. 비워두면 Twilio가 번호 국가 기준으로 자동 선택한다.
# 현재 프론트 타이머/문구는 Twilio Verify 기본 만료 시간인 10분 기준이다.
TWILIO_VERIFY_LOCALE=

# Redis - optional, defaults used if absent
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VALKEY_MODE=redis
REDIS_URL=redis://localhost:6379

# -- Email (Resend) --
# Required in production. Dev environment without these values falls back to console.log mock.
# Production: both RESEND_API_KEY and RESEND_FROM_EMAIL are hard-required (see EmailService constructor).
# RESEND_FROM_EMAIL must be a verified sender domain configured in Resend dashboard.
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM_EMAIL=no-reply@heygrabit.com

# App
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_QR_PUBLIC_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=http://localhost:8080
NODE_ENV=development

# R2 / CDN
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://cdn.heygrabit.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
NEXT_PUBLIC_R2_HOSTNAME=cdn.heygrabit.com
# Enable only after R2 CORS allows the Cache-Control request header.
R2_UPLOAD_CACHE_CONTROL_ENABLED=true

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
